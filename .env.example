

# --- Claude API (workflow generation, lib/generator.ts) ---
ANTHROPIC_API_KEY=

# --- CALL-E (lib/calle-client.ts, server side only) ---
CALLE_API_KEY=
# Optional. Defaults to https://api.heycall-e.com when unset.
CALLE_BASE_URL=

# Public base URL of this app, used to build the webhook_url sent on every call.
# Local development needs a tunnel (e.g. ngrok) for CALL-E to reach the webhook.
# Example: https://veyra.vercel.app
APP_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
